{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.10",
    "VERCEL": "1"
  },
  "functions": {
    "app.py": {
      "maxDuration": 30
    }
  }
}
